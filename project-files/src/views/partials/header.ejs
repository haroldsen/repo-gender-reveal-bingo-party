<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title %></title>
    <meta name="description" content="A fun twist where guests compete to reveal the baby's gender!  Gender Reveal Bingo Party makes it easy to throw an unforgettable gender reveal in minutes!">

    <link rel="stylesheet" href="/css/global.css">

    <!-- ICONS -->
    <link rel="icon" type="image/svg+xml" href="/images/fav.svg">
    <!-- Apple Devices -->
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon-180x180.png">
    <!-- Android Devices (and Google Chrome) -->
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#d2b3ff">
    
    <!-- og:title | The title of your content. -->
    <meta property="og:title" content="<%= title %>">
    <!-- og:type | The type of content (e.g., website, article, video.movie). -->
    <meta property="og:type" content="website">
    <!-- og:image | The URL of the image to be displayed in the preview. Crucial for engagement. -->
    <meta property="og:image" content="/images/logo-dark.svg">
    <!-- og:url | The canonical URL of the page. Helps consolidate likes/shares. -->
    <meta property="og:url" content="https://genderrevealbingo.party">
    <!-- og:description | A brief summary of the content (usually 2-4 sentences). -->
    <meta property="og:description" content="A fun twist where guests compete to reveal the baby's gender!  Gender Reveal Bingo Party makes it easy to throw an unforgettable gender reveal in minutes!">

    <!-- twitter:card | The type of Twitter card. Common values are summary or summary_large_image. -->
    <!-- Best Practice Note: You should use summary_large_image for the twitter:card whenever possible,
    as it results in a larger, more prominent image and typically has a higher CTR. -->
    <!-- <meta name="twitter:card" content="summary_large_image"> -->
    <!-- twitter:site | The Twitter handle of the website. -->
    <!-- <meta name="twitter:site" content="@yourcompanyname"> -->
    <!-- twitter:creator | The Twitter handle of the content creator. -->
    <!-- <meta name="twitter:creator" content="@authorname"> -->
    <!-- twitter:title | The title of your content (can be different from og:title). -->
    <!-- <meta name="twitter:title" content="My Twitter-Friendly Title"> -->
    <!-- twitter:image | The URL of the image for the card (can be different from og:image). -->
    <!-- <meta name="twitter:image" content="https://example.com/image.jpg"> -->

    <%- renderStyles() %>
    <%- renderScripts() %>

    <% if (NODE_ENV.includes('dev')) { %>
        <script>
            // Get the current hostname and port from the browser
            const host = window.location.hostname;
            const currentPort = window.location.port;
            // Calculate WebSocket port (current port + 1)
            const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;
            // Create WebSocket connection using dynamic hostname and port
            const ws = new WebSocket(`ws://${host}:${wsPort}`);
            ws.onclose = () => {
                setTimeout(() => location.reload(), 2000);
            };
        </script>
    <% } %>

    <!-- For Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W686TSMP');</script>
    <!-- End Google Tag Manager -->

</head>
<body>

    <!-- For Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W686TSMP"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <header>

        <div class="header-background">
            <a class="logo-link" href="/">
                <%- include('../svgs/logo') %>
            </a>

            <nav class="desktop-nav">
                <!-- Always visible links -->
                <a href="/">About Us</a>
                <a href="/contact-us">Contact Us</a>
                <a href="/card">Playable Card</a>
                <a href="/how-to">How to Host</a>

                <% if (isLoggedIn) { %>
                    <!-- Only visible when logged in -->
                    <a href="/my-games">My Games</a>
                <% } %>

                <% if (userRole == 'admin' || userRole == 'employee') { %>
                    <!-- Add links for admins -->
                    <a href="/dashboard">Admin</a>
                <% } %>

                <% if (isLoggedIn) { %>
                    <!-- Only visible when logged in -->
                    <a href="/logout">Log Out</a>
                <% } %>

                <% if (!isLoggedIn) { %>
                    <!-- Only visible when NOT logged in -->
                    <a href="/register">Create Account</a>
                    <a href="/login">Log In</a>
                <% } %>
            </nav>

            <details class="mobile-nav">
                <summary>
                    <p class="open-menu">Open Menu ▼</p>
                    <p class="close-menu">Close Menu ▲</p>
                </summary>

                <div class="link-stack">
                    <!-- Always visible links -->
                    <a href="/">About Us</a>
                    <a href="/contact-us">Contact Us</a>
                    <a href="/card">Playable Card</a>
                    <a href="/how-to">How to Host</a>

                    <% if (isLoggedIn) { %>
                        <!-- Only visible when logged in -->
                        <a href="/my-games">My Games</a>
                    <% } %>

                    <% if (userRole == 'admin' || userRole == 'employee') { %>
                        <!-- Add links for admins -->
                        <a href="/dashboard">Admin</a>
                    <% } %>

                    <% if (isLoggedIn) { %>
                        <!-- Only visible when logged in -->
                        <a href="/logout">Log Out</a>
                    <% } %>

                    <% if (!isLoggedIn) { %>
                        <!-- Only visible when NOT logged in -->
                        <a href="/register">Create Account</a>
                        <a href="/login">Log In</a>
                    <% } %>
                </div>

            </details>
        </div>

    </header>
    <main class="<%= mainClass %>">
        <%- include('flash-messages') %>