<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/css/global.css">

    <link rel="icon" type="image/svg+xml" href="/images/fav.svg">

    <%- renderStyles() %>
    <%- renderScripts() %>

    <% if (NODE_ENV.includes('dev')) { %>
        <script>
            // Get the current hostname and port from the browser
            const host = window.location.hostname;
            const currentPort = window.location.port;
            // Calculate WebSocket port (current port + 1)
            const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;
            // Create WebSocket connection using dynamic hostname and port
            const ws = new WebSocket(`ws://${host}:${wsPort}`);
            ws.onclose = () => {
                setTimeout(() => location.reload(), 2000);
            };
        </script>
    <% } %>

    <!-- For Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W686TSMP');</script>
    <!-- End Google Tag Manager -->

</head>
<body>

    <!-- For Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W686TSMP"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <header>

        <div class="header-background">
            <a class="logo-link" href="/">
                <%- include('../svgs/logo') %>
            </a>

            <nav class="desktop-nav">
                <!-- Always visible links -->
                <a href="/">About Us</a>
                <a href="/contact-us">Contact Us</a>
                <a href="/card">Playable Card</a>

                <% if (isLoggedIn) { %>
                    <!-- Only visible when logged in -->
                    <a href="/my-games">My Games</a>
                    <a href="/get-cards">Get Cards</a>
                <% } %>

                <% if (userRole == 'admin' || userRole == 'employee') { %>
                    <!-- Add links for admins -->
                    <a href="/dashboard">Admin</a>
                <% } %>

                <% if (isLoggedIn) { %>
                    <!-- Only visible when logged in -->
                    <a href="/logout">Log Out</a>
                <% } %>

                <% if (!isLoggedIn) { %>
                    <!-- Only visible when NOT logged in -->
                    <a href="/register">Create Account</a>
                    <a href="/login">Log In</a>
                <% } %>
            </nav>

            <details class="mobile-nav">
                <summary>
                    <p class="open-menu">Open Menu ▼</p>
                    <p class="close-menu">Close Menu ▲</p>
                </summary>

                <div class="link-stack">
                    <!-- Always visible links -->
                    <a href="/">About Us</a>
                    <a href="/contact-us">Contact Us</a>
                    <a href="/card">Playable Card</a>

                    <% if (isLoggedIn) { %>
                        <!-- Only visible when logged in -->
                        <a href="/my-games">My Games</a>
                        <a href="/get-cards">Get Cards</a>
                    <% } %>

                    <% if (userRole == 'admin' || userRole == 'employee') { %>
                        <!-- Add links for admins -->
                        <a href="/dashboard">Admin</a>
                    <% } %>

                    <% if (isLoggedIn) { %>
                        <!-- Only visible when logged in -->
                        <a href="/logout">Log Out</a>
                    <% } %>

                    <% if (!isLoggedIn) { %>
                        <!-- Only visible when NOT logged in -->
                        <a href="/register">Create Account</a>
                        <a href="/login">Log In</a>
                    <% } %>
                </div>

            </details>
        </div>

    </header>
    <main class="<%= mainClass %>">
        <%- include('flash-messages') %>