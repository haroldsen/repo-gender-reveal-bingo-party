<%- include('partials/header') %>
    <div class="page">
        <h1>My Games</h1>
        <ul id="my-games-list">
            <% if (games.length > 0) { %>
                <% for( let index = 0; index < games.length; index ++ ) { %>
                    <li>
                        <div class="game-details">
                            <p class="game-title"><%= games[index].title %></p>
                            <p>Last Edit: <%= games[index].lastEditInfo %> on <%= formatDate(games[index].lastEditAt) %></p>

                            <div class="game-options">
                                <a href="/my-games/play-game/<%= games[index].id %>" class="button">Launch Game</a>
                                <a href="/my-games/about-game/<%= games[index].id %>" class="button">About Game</a>
                            </div>
                        </div>
                    </li>
                <% } %>
            <% } else { %>
                <p>Click the button below to create your first game!</p>
            <% } %>
        </ul>
        <div class="purchase-div">
            <a href="/purchase-game/checkout" class="button">Purchase a Game</a>
            <p>$19.99 + tax</p>
        </div>
    </div>
<%- include('partials/footer') %>