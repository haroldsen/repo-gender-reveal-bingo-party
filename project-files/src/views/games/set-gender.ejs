<%- include('../partials/header') %>
    <form method="POST" action="/my-games/set-gender/<%= game.id %>" class="edit-game-form">
        
        <h1>Set Gender</h1>

        <!-- Gender field -->
        <div class="form-item">
            <label for="gender">Gender</label>
            <select
                id="gender"
                name="gender"
                required
            >
                <option
                    value="NONE"
                    <%= (game.gender && game.gender.toUpperCase() === 'NONE') ? 'selected' : '' %>
                >
                    NONE
                </option>
                <option
                    value="BOY"
                    <%= (game.gender && game.gender.toUpperCase() === 'BOY') ? 'selected' : '' %>
                >
                    BOY
                </option>
                <option
                    value="GIRL"
                    <%= (game.gender && game.gender.toUpperCase() === 'GIRL') ? 'selected' : '' %>
                >
                    GIRL
                </option>
            </select>
        </div>

        <button type="submit">Save Changes</button>
        <a href="/my-games/about-game/<%= game.id %>" class="button">Discard Changes</a>

        <!-- <p>Twins!?!?  Triplets!?!?!?</p>
        <button>Add Another Baby</button> -->

    </form>
<%- include('../partials/footer') %>