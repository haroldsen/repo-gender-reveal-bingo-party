<%- include('../partials/header') %>
    <div class="about-game page">
        <div>
            <h1>About Game</h1>
            <p>Title: <%= game.title %></p>
            <p>Created On: <%= formatDate(game.createdAt) %></p>
            <p>Last Edit: <%= game.lastEditInfo %> on <%= formatDate(game.lastEditAt) %></p>
        </div>

        <div>
            <h2>Edit Game</h2>
            <p>Use this button to change the title and gender of your game.</p>
            <a class="button" href="/my-games/edit-game/<%= game.id %>">
                Edit Game
            </a>
        </div>
        
        <div>
            <h2>Edit Link</h2>
            <p>
                Edit links can be shared with a doctor or close friend.
                This allows them to set the gender of your game without accessing your account.
            </p>
            <p>Edit links will expire after the gender has been set.</p>
            <% if (game.editLink.length > 10) { %>
                <p>Your edit link:</p>
                <div class="edit-link-area">
                    <p class="edit-link">https://genderrevealbingo.party/edit-link/<%= game.id %>/<%= game.editLink %></p>
                    <button class="copy-edit-link">
                        copy
                    </button>
                </div>
                <form
                    method="POST"
                    class="unstyled-form"
                    action="/my-games/delete-edit-link/<%= game.id %>"
                >
                    <button type="submit">
                        Delete Edit Link
                    </button>
                </form>
            <% } else { %>
                <form
                    method="POST"
                    class="unstyled-form"
                    action="/my-games/create-edit-link/<%= game.id %>"
                >
                    <button type="submit">
                        Create Edit Link
                    </button>
                </form>
            <% } %>
        </div>

        <div>
            <h2>Winning Card</h2>
            <p>After a game is completed, you can download a copy of the winning card for memories or as a keep-sake.</p>
            <p>If a game is launched more than once, the previous winning card will be overwritten with the most recent winning card.</p>

            <% if (game.lastWinningCard) { %>
                <p>Your winning card:</p>
                <button class="download-winning-card">Download Card</button>
            <% } else { %>
                <p>The option to download the winning card will appear here after this game has been launched.</p>
            <% } %>
        </div>

        <a class="button" href="/my-games">
            Go Back
        </a>
    </div>
    <div id="winning-card-container">
        <div id="winning-card-data"><%- JSON.stringify(game.lastWinningCard || '') %></div>
    </div>
    <script type="module">

        import { flashBrowserMessage } from '/js/partials/browser-message.mjs';
        import { getCards } from '/js/card-data.mjs';

        // COPY EDIT LINK

        const copyButton = document.querySelector('.copy-edit-link');

        if (copyButton) {
            copyButton.addEventListener('click', async () => {
                try {

                    const urlText = 'https://genderrevealbingo.party/edit-link/<%= game.id %>/<%= game.editLink %>';

                    // Use the Clipboard API to write text
                    await navigator.clipboard.writeText(urlText);
                    
                    flashBrowserMessage('Copied link to clipboard!', 'good');

                    copyButton.textContent = 'Copied';
                    setTimeout(() => copyButton.textContent = 'Copy', 2000);
                }
                
                catch (err) {

                    console.error('Failed to copy link: ', err);
                
                    flashBrowserMessage('Failed to copy link.', 'bad');

                    copyButton.textContent = 'Copy Failed';
                    setTimeout(() => copyButton.textContent = 'Copy', 2000);
                }
            });
        }

        // DOWNLOAD WINNING CARD

        const winningCardDataElement = document.querySelector('#winning-card-data');

        const winningCardData = JSON.parse(winningCardDataElement.innerHTML);

        const winningCardButton = document.querySelector('.download-winning-card');

        if (winningCardButton) {

            const cards = getCards();
            const winningCard = cards.find(card => card.id == winningCardData.id);

            const winningCardContainer = document.querySelector('#winning-card-container');

            winningCardContainer.innerHTML = winningCard.getToggledSVG(winningCardData.sequence);

            winningCardButton.addEventListener('click', () => {
                window.print();
            })
        }
    </script>
<%- include('../partials/footer') %>