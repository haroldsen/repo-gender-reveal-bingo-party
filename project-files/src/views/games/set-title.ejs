<%- include('../partials/header') %>
    <form method="POST" action="/my-games/set-title/<%= game.id %>" class="edit-game-form">
        
        <h1>Set Title</h1>

        <!-- Title field -->
        <div class="form-item">
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                required
                placeholder="Jack and Jill's Gender Reveal"
                value="<%= game.title %>"
            >
        </div>

        <button type="submit">Save Changes</button>
        <a href="/my-games/about-game/<%= game.id %>" class="button">Discard Changes</a>

        <!-- <p>Twins!?!?  Triplets!?!?!?</p>
        <button>Add Another Baby</button> -->

    </form>
<%- include('../partials/footer') %>