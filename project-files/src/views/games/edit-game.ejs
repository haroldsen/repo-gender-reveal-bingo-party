<%- include('../partials/header') %>
    <form method="POST" action="/my-games/edit-game/<%= gameId %>" class="edit-game-form">
        
        <h1>Edit Game</h1>

        <!-- Title field -->
        <div class="form-item">
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                required
                placeholder="Jack and Jill's Gender Reveal"
                value="<%= previousTitle %>"
            >
        </div>

        <!-- Gender field -->
        <div class="form-item">
            <label for="gender">Gender</label>
            <select
                id="gender"
                name="gender"
                required
            >
                <option
                    value="BOY"
                    <%= (currentGender && currentGender.toUpperCase() === 'BOY') ? 'selected' : '' %>
                >
                    BOY
                </option>
                <option
                    value="GIRL"
                    <%= (currentGender && currentGender.toUpperCase() === 'GIRL') ? 'selected' : '' %>
                >
                    GIRL
                </option>
            </select>
        </div>

        <!-- Submit button -->
        <button type="submit">Save Changes</button>

        <!-- <p>Twins!?!?  Triplets!?!?!?</p>
        <button>Add Another Baby</button> -->

    </form>
<%- include('../partials/footer') %>